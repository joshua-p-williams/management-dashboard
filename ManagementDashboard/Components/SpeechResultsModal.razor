<div class="modal fade show" tabindex="-1" style="display: block;" aria-modal="true" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-mic"></i> Speech to Text Results
                </h5>
                <button type="button" class="btn-close" aria-label="Close" @onclick="HandleCancel"></button>
            </div>
            <div class="modal-body">
                
                <!-- Transcription Quality Indicator (Optional) -->
                @if (TranscriptionConfidence.HasValue && TranscriptionConfidence.Value > 0)
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label mb-0">
                                <strong>Transcription Quality:</strong>
                            </label>
                            <span class="badge @GetConfidenceBadgeClass()">
                                @GetConfidenceText()
                            </span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar @GetConfidenceProgressClass()" 
                                 role="progressbar" 
                                 style="width: @((TranscriptionConfidence.Value * 100).ToString("0"))%"
                                 aria-valuenow="@((TranscriptionConfidence.Value * 100).ToString("0"))" 
                                 aria-valuemin="0" 
                                 aria-valuemax="100">
                            </div>
                        </div>
                        <small class="text-muted">
                            Higher quality transcriptions are more accurate
                        </small>
                    </div>
                }

                <div class="mb-3">
                    <label for="transcribedText" class="form-label">
                        <strong>Review and Edit Transcribed Text:</strong>
                    </label>
                    <textarea id="transcribedText" 
                              class="form-control" 
                              @bind="EditableText" 
                              rows="8" 
                              placeholder="Transcribed speech will appear here..."
                              spellcheck="true">
                    </textarea>
                    <small class="text-muted">
                        You can edit the text above before creating a task or work note. 
                        Speech recognition may need corrections for names, technical terms, or punctuation.
                    </small>
                </div>

                @if (!string.IsNullOrWhiteSpace(EditableText))
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        <strong>What would you like to do with this transcribed text?</strong>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <button type="button" 
                                    class="btn btn-success w-100" 
                                    @onclick="HandleCreateTask">
                                <i class="bi bi-check-square"></i>
                                <div class="mt-1">
                                    <strong>Create Task</strong><br>
                                    <small>Add to Eisenhower Matrix</small>
                                </div>
                            </button>
                        </div>
                        <div class="col-md-6 mb-2">
                            <button type="button" 
                                    class="btn btn-primary w-100" 
                                    @onclick="HandleCreateWorkNote">
                                <i class="bi bi-journal-text"></i>
                                <div class="mt-1">
                                    <strong>Save as Work Note</strong><br>
                                    <small>Add to Scrum Summary</small>
                                </div>
                            </button>
                        </div>
                    </div>

                    <!-- Speech-Specific Tips -->
                    <div class="mt-3">
                        <div class="alert alert-light border">
                            <small class="text-muted">
                                <i class="bi bi-lightbulb"></i>
                                <strong>Tips for speech transcription:</strong>
                                <ul class="mb-0 mt-2">
                                    <li>Check for proper punctuation and capitalization</li>
                                    <li>Verify names, technical terms, and acronyms</li>
                                    <li>Add missing periods, commas, and question marks</li>
                                </ul>
                            </small>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        No text was transcribed from the audio recording. Please try recording again with clearer speech.
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="HandleCancel">
                    <i class="bi bi-x-circle"></i> Cancel
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal-backdrop fade show"></div>
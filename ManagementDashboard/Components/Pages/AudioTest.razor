@page "/audio-test"
@using ManagementDashboard.Components

<h3>Audio Recording Modal Test</h3>

<div class="container py-4">
    <div class="card">
        <div class="card-header">
            <h5>Audio Recording & Speech Results Test</h5>
        </div>
        <div class="card-body">
            <p>Use this page to test the Audio Recording Modal and Speech Results Modal components.</p>

            <div class="mb-3">
                <button class="btn btn-primary me-2" @onclick="ShowAudioModal">
                    <i class="bi bi-mic"></i> Test Audio Recording Modal
                </button>

                <button class="btn btn-info" @onclick="ShowSpeechResultsModal">
                    <i class="bi bi-chat-text"></i> Test Speech Results Modal
                </button>
            </div>

            @if (recordedData != null)
            {
                <div class="alert alert-success mt-3">
                    <i class="bi bi-check-circle"></i>
                    Recording completed! Captured @recordedData.Length bytes of audio data.
                    <button class="btn btn-sm btn-outline-success ms-2" @onclick="ProcessRecordedAudio">
                        Process with Speech Recognition
                    </button>
                </div>
            }

            @if (speechResults != null)
            {
                <div class="alert alert-info mt-3">
                    <i class="bi bi-chat-text"></i>
                    <strong>Action taken:</strong> @speechResults
                </div>
            }

            <!-- Audio Recording Modal -->
            @if (showAudioModal)
            {
                <AudioRecordingModal 
                    OnCancel="HandleAudioCancel"
                    OnRecordingComplete="HandleRecordingComplete" />
            }

            <!-- Speech Results Modal -->
            @if (showSpeechResultsModal)
            {
                <SpeechResultsModal 
                    TranscribedText="@sampleTranscriptionText"
                    TranscriptionConfidence="@sampleConfidence"
                    OnCancel="HandleSpeechResultsCancel"
                    OnCreateTask="HandleCreateTaskFromSpeech"
                    OnCreateWorkNote="HandleCreateWorkNoteFromSpeech" />
            }
        </div>
    </div>
</div>

@code {
    private bool showAudioModal = false;
    private bool showSpeechResultsModal = false;
    private byte[]? recordedData = null;
    private string? speechResults = null;

    // Sample data for testing Speech Results Modal
    private string sampleTranscriptionText = "call the client about the project update and schedule a meeting for next week to discuss the requirements and timeline";
    private float sampleConfidence = 0.92f;

    private void ShowAudioModal()
    {
        showAudioModal = true;
        recordedData = null;
        speechResults = null;
    }

    private void ShowSpeechResultsModal()
    {
        showSpeechResultsModal = true;
        speechResults = null;
    }

    private void HandleAudioCancel()
    {
        showAudioModal = false;
    }

    private void HandleRecordingComplete(byte[] audioData)
    {
        recordedData = audioData;
        showAudioModal = false;
    }

    private void ProcessRecordedAudio()
    {
        // Simulate processing the recorded audio
        sampleTranscriptionText = "This is a simulated transcription of your recorded audio. In a real implementation this would be processed by Azure Speech Services.";
        sampleConfidence = 0.87f;
        showSpeechResultsModal = true;
    }

    private void HandleSpeechResultsCancel()
    {
        showSpeechResultsModal = false;
    }

    private void HandleCreateTaskFromSpeech(string text)
    {
        speechResults = $"Created task with text: '{text.Substring(0, Math.Min(text.Length, 50))}...'";
        showSpeechResultsModal = false;
    }

    private void HandleCreateWorkNoteFromSpeech(string text)
    {
        speechResults = $"Created work note with text: '{text.Substring(0, Math.Min(text.Length, 50))}...'";
        showSpeechResultsModal = false;
    }
}